rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /travelers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'lastSeenAt']);
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'lastSeenAt']));
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
  }
}