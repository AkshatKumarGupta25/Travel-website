rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    match /travelers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'lastSeenAt']);
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'lastSeenAt']));
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.published == false
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.name is string
        && request.resource.data.destination is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 800
        && request.resource.data.maxTravelers is int
        && request.resource.data.maxTravelers >= 2
        && request.resource.data.maxTravelers <= 30
        && request.resource.data.keys().hasOnly([
          'name', 'region', 'destination', 'days', 'price', 'image', 'description',
          'imageSource', 'imageCredit', 'imageCreditUrl', 'tag', 'published',
          'approvalStatus', 'ownerUid', 'ownerName',
          'startDate', 'maxTravelers', 'createdAt', 'updatedAt'
        ]));
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.published == false
        && request.resource.data.published == false
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'region', 'destination', 'days', 'price', 'image', 'description',
          'imageSource', 'imageCredit', 'imageCreditUrl',
          'tag', 'startDate', 'maxTravelers', 'updatedAt'
        ]));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.published == false);

      match /requests/{requestId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        allow read: if isAdmin() || (signedIn()
          && (resource.data.travelerUid == request.auth.uid
            || trip().ownerUid == request.auth.uid));
        allow create: if signedIn()
          && trip().published == true
          && trip().ownerUid != request.auth.uid
          && request.resource.data.tripId == tripId
          && request.resource.data.ownerUid == trip().ownerUid
          && request.resource.data.travelerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'tripId', 'tripName', 'ownerUid', 'travelerUid',
            'travelerName', 'travelerEmail', 'status', 'createdAt'
          ]);
        allow update: if isAdmin() || (signedIn()
          && trip().ownerUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
  }
}